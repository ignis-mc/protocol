from nethernet.wire import hex_decode, hex_encode
from std.testing import (
    TestSuite,
    assert_equal,
    assert_false,
    assert_raises,
    assert_true,
)
from tls.bigint import BigUInt, MontgomeryModulus, mod_exp


def _big(text: StringSpan) raises -> BigUInt:
    var bytes = hex_decode(text)
    return BigUInt.from_bytes_be(Span(bytes))


def _hex(value: BigUInt) raises -> String:
    # Minimal big-endian hex with an even digit count, "" for zero.
    var bytes = value.to_bytes_be((value.bit_length() + 7) // 8)
    return hex_encode(Span(bytes))


def _check(
    base: StringSpan,
    exponent: StringSpan,
    modulus: StringSpan,
    expected: StringSpan,
) raises:
    assert_equal(
        _hex(mod_exp(_big(base), _big(exponent), _big(modulus))), expected
    )


def test_bytes_round_trip() raises:
    var v = _big("000102030405060708090a0b0c0d0e0f10")
    assert_equal(len(v.limbs), 2)
    assert_equal(v.bit_length(), 121)
    assert_equal(
        hex_encode(Span(v.to_bytes_be(20))),
        "000000000102030405060708090a0b0c0d0e0f10",
    )
    assert_equal(String(v), "0x102030405060708090a0b0c0d0e0f10")
    with assert_raises():
        _ = v.to_bytes_be(15)
    var zero = _big("0000")
    assert_true(zero.is_zero())
    assert_equal(zero.bit_length(), 0)
    assert_equal(hex_encode(Span(zero.to_bytes_be(2))), "0000")
    assert_equal(String(zero), "0x0")


def test_compare_and_bits() raises:
    var a = _big("0100000000000000000000")
    var b = _big("00ffffffffffffffffffff")
    assert_true(b < a)
    assert_false(a < b)
    assert_equal(a.compare(b), 1)
    assert_equal(b.compare(a), -1)
    assert_true(a == _big("000100000000000000000000"))
    assert_true(a.bit(80))
    assert_false(a.bit(79))
    assert_false(a.bit(1000))
    assert_true(b.is_odd())
    assert_false(a.is_odd())


def test_small_values() raises:
    assert_equal(_hex(mod_exp(BigUInt(4), BigUInt(13), BigUInt(497))), "01bd")
    # Exponent zero gives one; base zero gives zero.
    assert_equal(_hex(mod_exp(BigUInt(5), BigUInt(), BigUInt(7))), "01")
    assert_equal(_hex(mod_exp(BigUInt(), BigUInt(9), BigUInt(7))), "")
    # x^(p-1) = 1 mod p for the prime 2^61 - 1.
    var p = BigUInt(0x1FFF_FFFF_FFFF_FFFF)
    var e = BigUInt(0x1FFF_FFFF_FFFF_FFFE)
    assert_equal(_hex(mod_exp(BigUInt(123456789), e, p)), "01")


def test_rejects_bad_operands() raises:
    with assert_raises():
        _ = MontgomeryModulus(BigUInt(10))
    with assert_raises():
        _ = MontgomeryModulus(BigUInt(1))
    with assert_raises():
        _ = mod_exp(BigUInt(7), BigUInt(3), BigUInt(7))


def test_random_against_python() raises:
    # Generated with Python's pow(base, exponent, modulus), seed 20261113:
    # 64- to 4096-bit moduli, exponents 3, 65537 and full-width ones.
    _check(
        "21709310d5842321",
        "010001",
        "84abcdab2dbc1c77",
        "01b9e5434e2879ba",
    )
    _check(
